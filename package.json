{
  "name": "reservations",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:commands": "esbuild src/commands/migrate.ts src/commands/register-business.ts src/commands/reset-admin-password.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist/commands --out-extension:.js=.cjs --log-level=warning",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:app": "tsx src/commands/migrate.ts",
    "business:register": "tsx src/commands/register-business.ts",
    "admin:reset-password": "tsx src/commands/reset-admin-password.ts"
  },
  "dependencies": {
    "@next/env": "^16.4.5",
    "@sentry/nextjs": "11.11.0",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "sass": "^1.107.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
