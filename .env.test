# Variables para `npm test`. Se versiona: los tests usan siempre la misma configuración.
# Base separada de la de desarrollo, porque los tests la vacían antes de cada test.
DATABASE_URL="postgres://reservas:reservas@localhost:5432/reservas_test"

# Secreto fijo, solo para tests.
BETTER_AUTH_SECRET="secreto-de-tests-no-usar-en-produccion-0123456789"
BETTER_AUTH_URL="http://localhost:3000"
