# Copy to `.env.local` for development: cp .env.example .env.local

NEXT_PUBLIC_APP_NAME="Reservas"

# Postgres connection (started by `docker compose up -d`).
DATABASE_URL="postgres://reservas:reservas@localhost:5432/reservas"

# Better Auth (panel login). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-secret-of-at-least-32-characters"
# Base URL of the app.
BETTER_AUTH_URL="http://localhost:3000"

# Emails. In development they go to Mailpit (started by `docker compose up -d`) and are
# seen at http://localhost:8025. In production: EMAIL_TRANSPORT="resend", with the API key
# and a sender address of a domain verified in Resend.
EMAIL_TRANSPORT="mailpit"
# EMAIL_FROM="reservas@tudominio.com"
# RESEND_API_KEY="re_..."
# MAILPIT_URL="http://localhost:8025"
