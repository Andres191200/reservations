# Copiar a `.env.local` para desarrollo: cp .env.example .env.local

NEXT_PUBLIC_APP_NAME="Reservas"

# Conexión a Postgres (la levanta `docker compose up -d`).
DATABASE_URL="postgres://reservas:reservas@localhost:5432/reservas"

# Better Auth (login del panel). Generar el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET="cambiar-por-un-secreto-de-al-menos-32-caracteres"
# URL base de la app.
BETTER_AUTH_URL="http://localhost:3000"
