# Production environment. Copy it to `.env.production` (never committed) and fill it in:
#   cp .env.production.example .env.production
# Every service of compose.prod.yml reads it. See docs/produccion.md.

# --- Domain -------------------------------------------------------------------------
# The domain Caddy serves (and gets HTTPS for). Locally: localhost.
DOMAIN="reservas.tudominio.com"

# --- Database -----------------------------------------------------------------------
# The Postgres container creates this user and database the first time it starts.
POSTGRES_USER="reservas"
# Generate it with: openssl rand -hex 24
POSTGRES_PASSWORD=""
POSTGRES_DB="reservas"
# The app reaches Postgres by its service name, `postgres`. Same user, password and base.
DATABASE_URL="postgres://reservas:CAMBIAR_POR_POSTGRES_PASSWORD@postgres:5432/reservas"

# --- App ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Reservas"
# Generate it with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The public URL of the app: what the emails' links use.
BETTER_AUTH_URL="https://reservas.tudominio.com"

# --- Emails (Resend) ----------------------------------------------------------------
EMAIL_TRANSPORT="resend"
# A sender of a domain verified in Resend.
EMAIL_FROM="reservas@tudominio.com"
RESEND_API_KEY=""

# --- Cloudflare Turnstile (mandatory in production) ---------------------------------
# Cloudflare panel > Turnstile, "Invisible" mode.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Sentry (optional) --------------------------------------------------------------
# Read when building the image: changing it means building again.
# NEXT_PUBLIC_SENTRY_DSN="https://clave@o0.ingest.sentry.io/0"
